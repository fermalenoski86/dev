{
  "name": "trust-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "db:migrate": "pnpm --filter @trust/platform-api db:migrate",
    "docs:contract": "pnpm --filter @trust/platform-api docs:contract",
    "acceptance:generate": "node scripts/acceptance/cli.mjs generate",
    "acceptance:check": "node scripts/acceptance/cli.mjs check",
    "dev": "pnpm --filter @trust/previs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint \"{packages,apps}/*/src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "e2e": "pnpm dlx @playwright/test test",
    "emit:examples": "vitest run --config vitest.emit.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=12 <13"
  }
}
