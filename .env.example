# MASTER OF TRUST — platform (M3A). Sin secretos reales: copiar a .env y completar.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Superusuario SOLO para crear bases descartables en tests (nunca en runtime).
TRUST_PG_ADMIN_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5433/postgres
TRUST_PG_OWNER_PASSWORD=CHANGE_ME
TRUST_PG_APP_PASSWORD=CHANGE_ME
# Runtime de platform-api (usuario trust_app).
DATABASE_URL=postgres://trust_app:CHANGE_ME@127.0.0.1:5433/trust

# ── Almacenamiento ────────────────────────────────────────────────────────
STORAGE_DRIVER=local            # local | s3
LOCAL_STORAGE_ROOT=/var/lib/trust/storage   # absoluto, fuera de cualquier dir web

S3_ENDPOINT=http://127.0.0.1:9000           # vacío para AWS S3
S3_REGION=us-east-1
S3_BUCKET=trust-assets
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true                    # true para MinIO
S3_TEST_ENDPOINT=                           # solo CI: habilita el contrato S3

# ── Assets / medios (Fase B2–B4) ───────────────────────────────────────────────────
MAX_UPLOAD_BYTES=524288000      # 500 MB (desarrollo)
MAX_EVIDENCE_BYTES=26214400     # 25 MiB: evidencia de aprobación (PDF, email, texto, PNG/JPEG)
MEDIA_PROBE_TIMEOUT_MS=15000
MEDIA_DECODE_TIMEOUT_MS=20000
TEMP_OBJECT_TTL_MS=86400000     # 24 h
MEDIA_INSPECTION_CONCURRENCY=2  # procesos ffprobe/ffmpeg vivos a la vez
MEDIA_SCRATCH_DIR=/var/lib/trust/media-scratch   # 0700, fuera de dirs web
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg

# ── platform-api (Fase B4) ────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
NODE_ENV=development

# ── auth (Fase C1) ────────────────────────────────────────────────────────
# Identidad por sesión server-side (cookie). TRUST_DEV_ACTOR_PROVIDER ya no
# existe: si está definida, el server no arranca.
# Vencimiento absoluto de la sesión, en minutos (5–1440).
TRUST_SESSION_TTL_MINUTES=480
# Cookie Secure. En producción es siempre true y la cookie se llama
# __Host-trust_session; false solo para desarrollo por http://localhost.
TRUST_COOKIE_SECURE=false
# Saltos de reverse proxy confiables para la IP del cliente (rate limit). 0 = socket.
TRUST_PROXY_HOPS=0
# EXTERNAL_APPROVER: modelado y testeado, apagado por defecto (§22).
EXTERNAL_APPROVAL_ENABLED=false
# Alta de usuarios (CLI user:create): la contraseña se lee de esta variable o de stdin.
# Nunca la dejes en un archivo versionado.
# TRUST_NEW_USER_PASSWORD=
